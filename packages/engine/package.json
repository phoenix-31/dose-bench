{
  "name": "@dose-bench/engine",
  "version": "0.1.0",
  "description": "Dependency-free core of DOSE: grid prior, logit likelihood, expected-information question selection, Bayes updating, live sessions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "dose-bench-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/dose-bench",
    "directory": "packages/engine"
  },
  "keywords": [
    "dose",
    "preference elicitation",
    "bayesian adaptive design",
    "experimental economics",
    "risk aversion",
    "loss aversion",
    "time preference"
  ]
}

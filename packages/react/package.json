{
  "name": "@dose-bench/react",
  "version": "0.1.0",
  "description": "React hooks and unstyled components for running DOSE in the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/dose-bench",
    "directory": "packages/react"
  },
  "keywords": [
    "dose",
    "preference elicitation",
    "bayesian adaptive design",
    "experimental economics",
    "risk aversion",
    "loss aversion",
    "time preference"
  ],
  "dependencies": {
    "@dose-bench/engine": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "@types/react": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0"
  }
}

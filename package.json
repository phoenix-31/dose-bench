{
  "name": "dose-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./integrations/**\" --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @dose-bench/bench dev",
    "dose": "pnpm --filter @dose-bench/cli exec dose",
    "changeset": "changeset",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
